{"mode":"html","type":"text","code":"<title>Taller de Ladrillos</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Atkinson+Hyperlegible:wght@400;700&display=swap\">\n<style>\n/* Layout: banda de herramientas arriba, paleta de piezas a la izquierda, mesa 3D al centro, lista de piezas a la derecha. Se apila en celular. */\n:root{\n  --bg:#e9edf3; --panel:#f7f9fc; --line:#cfd6e2; --ink:#18223a; --muted:#5b6780;\n  --bar:#1b2a4a; --bar-ink:#f4f6fb; --accent:#f2b705; --accent-ink:#1b2a4a;\n  --danger:#c8281e; --scene:#cdd4df; --chip:#e2e7f0;\n  --display:\"Bricolage Grotesque\", \"Arial Black\", system-ui, sans-serif;\n  --body:\"Atkinson Hyperlegible\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n@media (prefers-color-scheme: dark){:root:not([data-theme=\"light\"]){\n  --bg:#0f1420; --panel:#161d2c; --line:#2a3448; --ink:#e7ebf3; --muted:#9aa5bb;\n  --bar:#0b1120; --bar-ink:#e7ebf3; --accent:#f2b705; --accent-ink:#141a26;\n  --danger:#ff6b5e; --scene:#1d2536; --chip:#222b3e; color-scheme:dark}}\n:root[data-theme=\"dark\"]{\n  --bg:#0f1420; --panel:#161d2c; --line:#2a3448; --ink:#e7ebf3; --muted:#9aa5bb;\n  --bar:#0b1120; --bar-ink:#e7ebf3; --accent:#f2b705; --accent-ink:#141a26;\n  --danger:#ff6b5e; --scene:#1d2536; --chip:#222b3e; color-scheme:dark}\nhtml,body{height:100%}\nbody{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:14px;overflow:hidden}\n*{box-sizing:border-box}\nbutton{font:inherit;color:inherit}\n:focus-visible{outline:3px solid var(--accent);outline-offset:2px}\n\n.app{height:100%;display:grid;grid-template-rows:auto 1fr;}\nheader{background:var(--bar);color:var(--bar-ink);display:flex;align-items:center;gap:14px;flex-wrap:wrap;\n  padding-block:8px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}\n.brand{display:flex;align-items:center;gap:10px;margin-right:auto}\n.logo{width:30px;height:22px;background:var(--danger);border-radius:3px;position:relative;box-shadow:inset 0 -4px 0 rgba(0,0,0,.25)}\n.logo::before,.logo::after{content:\"\";position:absolute;top:-5px;width:9px;height:6px;border-radius:2px 2px 0 0;background:var(--danger)}\n.logo::before{left:4px}.logo::after{right:4px}\n.brand h1{font-family:var(--display);font-weight:800;font-size:19px;letter-spacing:-.01em;margin:0;line-height:1}\n.brand small{display:block;font-size:11px;opacity:.7;letter-spacing:.06em;text-transform:uppercase;margin-top:3px}\n.compat{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.07);border-radius:9px;padding:4px 10px 4px 4px}\n.compat img{width:40px;height:40px;object-fit:contain;display:block}\n.compat span{font-size:11px;line-height:1.3;opacity:.85}\n.compat em{font-style:normal;opacity:.7}\n.group{display:flex;gap:4px;background:rgba(255,255,255,.07);padding:4px;border-radius:9px}\n.tool{border:0;background:transparent;color:var(--bar-ink);padding:7px 10px;border-radius:6px;cursor:pointer;display:flex;align-items:center;gap:6px;font-size:13px}\n.tool:hover{background:rgba(255,255,255,.12)}\n.tool[aria-pressed=\"true\"]{background:var(--accent);color:var(--accent-ink);font-weight:700}\n.tool kbd{font-family:inherit;font-size:10px;opacity:.6;border:1px solid currentColor;border-radius:3px;padding:0 3px}\n.tool:disabled{opacity:.35;cursor:default}\n.tool svg{width:16px;height:16px}\n\nmain{display:grid;grid-template-columns:232px 1fr 240px;min-height:0}\naside{background:var(--panel);border-color:var(--line);overflow:auto;min-height:0;padding:14px 12px;display:flex;flex-direction:column;gap:16px}\n#palette{border-right:1px solid var(--line)}\n#parts{border-left:1px solid var(--line)}\n.label{font-size:11px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:700;margin:0 0 8px}\n.swatches{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}\n.sw{aspect-ratio:1;max-width:100%;border-radius:7px;border:2px solid var(--line);cursor:pointer;padding:0;position:relative}\n.sw[aria-pressed=\"true\"]{border-color:var(--ink);box-shadow:0 0 0 2px var(--panel) inset}\n.pieces{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}\n.pc{background:var(--chip);border:2px solid transparent;border-radius:8px;cursor:pointer;padding:4px 2px 5px;display:flex;flex-direction:column;align-items:center;gap:1px}\n.pc img{width:100%;max-width:64px;aspect-ratio:1;display:block}\n.pc span{font-size:11px;font-variant-numeric:tabular-nums;color:var(--muted)}\n.pc[aria-pressed=\"true\"]{border-color:var(--accent);background:var(--panel)}\n.pc[aria-pressed=\"true\"] span{color:var(--ink);font-weight:700}\n.cat{font-size:12px;font-weight:700;margin:10px 0 6px}\n.cat:first-child{margin-top:0}\n\n.stage{position:relative;min-width:0;min-height:0;background:var(--scene)}\n#view{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}\n.hud{position:absolute;left:12px;bottom:12px;right:12px;display:flex;gap:8px;flex-wrap:wrap;pointer-events:none;align-items:flex-end}\n.pill{background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:5px 11px;font-size:12px;font-variant-numeric:tabular-nums;pointer-events:auto}\n.pill b{font-weight:700}\n.hint{margin-left:auto;color:var(--muted)}\n.banner{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:center;pointer-events:none}\n.banner div{pointer-events:auto;background:var(--accent);color:var(--accent-ink);border-radius:8px;padding:7px 12px;font-size:13px;display:flex;gap:10px;align-items:center;box-shadow:0 4px 14px rgba(0,0,0,.15)}\n.banner button{background:var(--accent-ink);color:var(--accent);border:0;border-radius:5px;padding:4px 9px;cursor:pointer;font-weight:700}\n.banner .x{background:transparent;color:var(--accent-ink);padding:2px 6px}\n\n.bom{display:flex;flex-direction:column;gap:2px;font-variant-numeric:tabular-nums}\n.bom .row{display:grid;grid-template-columns:14px 1fr auto;gap:8px;align-items:center;padding:5px 4px;border-bottom:1px solid var(--line);font-size:13px}\n.bom .dot{width:14px;height:14px;border-radius:3px;border:1px solid rgba(0,0,0,.2)}\n.bom .n{font-weight:700}\n.empty{color:var(--muted);font-size:13px;line-height:1.45}\n.total{display:flex;justify-content:space-between;font-weight:700;font-size:13px;padding:6px 4px}\n.btns{display:flex;flex-wrap:wrap;gap:6px}\n.btn{border:1px solid var(--line);background:var(--chip);border-radius:7px;padding:7px 10px;cursor:pointer;font-size:13px}\n.btn:hover{border-color:var(--muted)}\n.btn.warn{color:var(--danger)}\n.keys{font-size:12px;color:var(--muted);line-height:1.6;margin:0;padding-left:16px}\n.keys b{color:var(--ink)}\n\ndialog{border:1px solid var(--line);border-radius:12px;background:var(--panel);color:var(--ink);width:min(560px,calc(100% - 32px));padding:18px}\ndialog::backdrop{background:rgba(10,15,25,.5)}\ndialog h2{font-family:var(--display);margin:0 0 6px;font-size:20px}\ndialog p{margin:0 0 10px;color:var(--muted);line-height:1.45}\ndialog textarea{width:100%;height:180px;font-family:ui-monospace,Menlo,monospace;font-size:12px;background:var(--bg);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px}\ndialog .btns{margin-top:10px;justify-content:flex-end}\n.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--bar);color:var(--bar-ink);padding:8px 14px;border-radius:8px;font-size:13px;z-index:20}\n.mob{display:none}\n\n@media (max-width:820px){\n  main{grid-template-columns:1fr;grid-template-rows:1fr auto}\n  #palette{grid-row:2;border-right:0;border-top:1px solid var(--line);max-height:36vh;padding-left:max(12px,env(safe-area-inset-left,0px));padding-right:max(12px,env(safe-area-inset-right,0px))}\n  .pieces{grid-template-columns:repeat(6,1fr)}\n  .swatches{grid-template-columns:repeat(10,1fr)}\n  #parts{position:fixed;inset:auto 0 0 0;max-height:60vh;z-index:15;border-left:0;border-top:2px solid var(--line);box-shadow:0 -10px 30px rgba(0,0,0,.2);padding-bottom:calc(14px + env(safe-area-inset-bottom,0px))}\n  #parts:not(.open){display:none}\n  .mob{display:inline-flex}\n  .tool .t{display:none}\n  .hint{display:none}\n  .brand small{display:none}\n  .compat span{display:none}\n  .compat{padding:4px}\n}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n</style>\n\n<div class=\"app\">\n<header>\n  <div class=\"brand\"><div class=\"logo\" aria-hidden=\"true\"></div><div><h1>Taller de Ladrillos</h1><small>Prototipos tipo Rasti</small></div></div>\n  <div class=\"compat\"><img src=\"data:image/png;base64,\" alt=\"Logo de Rasti\"><span>Para piezas Rasti<br><em>Herramienta no oficial</em></span></div>\n  <div class=\"group\" role=\"toolbar\" aria-label=\"Herramientas\">\n    <button class=\"tool\" id=\"t-place\" data-tool=\"place\" aria-pressed=\"true\" title=\"Colocar pieza (1)\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M8 3v10M3 8h10\"/></svg><span class=\"t\">Colocar</span> <kbd class=\"t\">1</kbd></button>\n    <button class=\"tool\" id=\"t-paint\" data-tool=\"paint\" aria-pressed=\"false\" title=\"Pintar pieza (2)\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 13c2 0 3-1 3-3l6-6 2 2-6 6c-2 0-3 1-5 1z\"/></svg><span class=\"t\">Pintar</span> <kbd class=\"t\">2</kbd></button>\n    <button class=\"tool\" id=\"t-pick\" data-tool=\"pick\" aria-pressed=\"false\" title=\"Copiar pieza (3)\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"5\" y=\"5\" width=\"8\" height=\"8\" rx=\"1\"/><path d=\"M3 10V3h7\"/></svg><span class=\"t\">Copiar</span> <kbd class=\"t\">3</kbd></button>\n    <button class=\"tool\" id=\"t-delete\" data-tool=\"delete\" aria-pressed=\"false\" title=\"Quitar pieza (4)\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 4l8 8M12 4l-8 8\"/></svg><span class=\"t\">Quitar</span> <kbd class=\"t\">4</kbd></button>\n  </div>\n  <div class=\"group\">\n    <button class=\"tool\" id=\"rot\" title=\"Girar pieza (R)\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M13 8a5 5 0 1 1-1.5-3.5M13 2v3h-3\"/></svg><span class=\"t\">Girar</span> <kbd class=\"t\">R</kbd></button>\n    <button class=\"tool\" id=\"undo\" title=\"Deshacer (Ctrl+Z)\" disabled><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M5 4L2 7l3 3M2 7h8a4 4 0 0 1 0 8H7\"/></svg></button>\n    <button class=\"tool\" id=\"redo\" title=\"Rehacer (Ctrl+Y)\" disabled><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M11 4l3 3-3 3M14 7H6a4 4 0 0 0 0 8h3\"/></svg></button>\n    <button class=\"tool\" id=\"home\" title=\"Centrar vista (C)\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"8\" cy=\"8\" r=\"5\"/><circle cx=\"8\" cy=\"8\" r=\"1.5\" fill=\"currentColor\"/></svg></button>\n    <button class=\"tool mob\" id=\"partsBtn\" title=\"Lista de piezas\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M3 4h10M3 8h10M3 12h10\"/></svg></button>\n  </div>\n</header>\n\n<main>\n  <aside id=\"palette\" aria-label=\"Piezas y colores\">\n    <section>\n      <p class=\"label\">Color</p>\n      <div class=\"swatches\" id=\"swatches\"></div>\n    </section>\n    <section>\n      <p class=\"label\">Piezas</p>\n      <div id=\"pieces\"></div>\n    </section>\n  </aside>\n\n  <div class=\"stage\">\n    <canvas id=\"view\" aria-label=\"Mesa de construcción en 3D\"></canvas>\n    <div class=\"banner\" id=\"banner\"><div>Modelo de ejemplo: una casita. <button id=\"newBtn\">Empezar de cero</button><button class=\"x\" id=\"bannerX\" aria-label=\"Cerrar aviso\">✕</button></div></div>\n    <div class=\"hud\">\n      <span class=\"pill\" id=\"status\">—</span>\n      <span class=\"pill hint\">Clic: acción · Arrastrar: girar cámara · Clic derecho: desplazar · Rueda: zoom</span>\n    </div>\n  </div>\n\n  <aside id=\"parts\" aria-label=\"Lista de piezas\">\n    <section>\n      <p class=\"label\">Lista de piezas</p>\n      <div class=\"bom\" id=\"bom\"></div>\n    </section>\n    <section>\n      <p class=\"label\">Proyecto</p>\n      <div class=\"btns\">\n        <button class=\"btn\" id=\"expBtn\">Exportar</button>\n        <button class=\"btn\" id=\"impBtn\">Importar</button>\n        <button class=\"btn\" id=\"sampleBtn\">Ejemplo</button>\n        <button class=\"btn warn\" id=\"clearBtn\">Vaciar</button>\n      </div>\n      <p class=\"empty\" style=\"margin-top:8px\">Se guarda solo en este navegador.</p>\n    </section>\n    <section>\n      <p class=\"label\">Atajos</p>\n      <ul class=\"keys\">\n        <li><b>R</b> girar · <b>1–4</b> herramienta</li>\n        <li><b>Ctrl+Z / Ctrl+Y</b> deshacer / rehacer</li>\n        <li><b>C</b> centrar vista</li>\n        <li><b>Mayús + clic</b> quitar rápido</li>\n      </ul>\n    </section>\n  </aside>\n</main>\n</div>\n\n<dialog id=\"dlg\">\n  <h2 id=\"dlgTitle\">Exportar</h2>\n  <p id=\"dlgText\"></p>\n  <textarea id=\"dlgArea\" spellcheck=\"false\"></textarea>\n  <div class=\"btns\">\n    <label class=\"btn\" id=\"fileLbl\" hidden>Abrir archivo .json<input type=\"file\" id=\"fileIn\" accept=\".json,application/json\" hidden></label>\n    <button class=\"btn\" id=\"dlgCancel\">Cerrar</button>\n    <button class=\"btn\" id=\"dlgOk\" style=\"background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:700\">Copiar</button>\n  </div>\n</dialog>\n<div class=\"toast\" id=\"toast\" hidden></div>\n\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script>\n(() => {\nconst N = 32;          // tamaño de la base en tetones\nconst PH = 0.4;        // alto de una placa (un ladrillo = 3 placas)\nconst STORE = 'taller-ladrillos-v1';\n\nconst COLORS = [\n  {id:'rojo',name:'Rojo',hex:'#c8281e'},{id:'amarillo',name:'Amarillo',hex:'#f2b705'},\n  {id:'azul',name:'Azul',hex:'#1f55b3'},{id:'blanco',name:'Blanco',hex:'#f1f1ec'},\n  {id:'negro',name:'Negro',hex:'#26282c'},{id:'verde',name:'Verde',hex:'#1f8a46'},\n  {id:'naranja',name:'Naranja',hex:'#e8701a'},{id:'gris',name:'Gris',hex:'#8b929c'},\n  {id:'celeste',name:'Celeste',hex:'#5bb7e5'},{id:'marron',name:'Marrón',hex:'#6b3f22'}\n];\nconst T = (id,name,w,d,h,cat,kind='box') => ({id,name,w,d,h,cat,kind});\nconst TYPES = [\n  T('b1x1','1×1',1,1,3,'Ladrillos'),T('b1x2','1×2',2,1,3,'Ladrillos'),T('b1x3','1×3',3,1,3,'Ladrillos'),\n  T('b1x4','1×4',4,1,3,'Ladrillos'),T('b1x6','1×6',6,1,3,'Ladrillos'),T('b1x8','1×8',8,1,3,'Ladrillos'),\n  T('b2x2','2×2',2,2,3,'Ladrillos'),T('b2x3','2×3',3,2,3,'Ladrillos'),T('b2x4','2×4',4,2,3,'Ladrillos'),\n  T('b2x6','2×6',6,2,3,'Ladrillos'),T('b2x8','2×8',8,2,3,'Ladrillos'),T('b4x4','4×4',4,4,3,'Ladrillos'),\n  T('p1x2','1×2',2,1,1,'Placas'),T('p1x4','1×4',4,1,1,'Placas'),T('p2x2','2×2',2,2,1,'Placas'),\n  T('p2x4','2×4',4,2,1,'Placas'),T('p4x4','4×4',4,4,1,'Placas'),T('p4x8','4×8',8,4,1,'Placas'),\n  T('s1x2','1×2',1,2,3,'Tejas','slope'),T('s2x2','2×2',2,2,3,'Tejas','slope'),T('s4x2','4×2',4,2,3,'Tejas','slope'),\n  T('c1x1','Redondo',1,1,3,'Especiales','round'),T('w1x2','Ventana',2,1,3,'Especiales','window'),T('t2x2','Liso 2×2',2,2,1,'Especiales','tile')\n];\nconst TYPE = Object.fromEntries(TYPES.map(t=>[t.id,t]));\nconst COLOR = Object.fromEntries(COLORS.map(c=>[c.id,c]));\nconst catLabel = {Ladrillos:'Ladrillo',Placas:'Placa',Tejas:'Teja',Especiales:''};\n\n// ---------- estado ----------\nlet bricks = [];       // {id,type,color,x,z,l,rot}\nlet nextId = 1;\nlet tool = 'place', curType = 'b2x4', curColor = 'rojo', curRot = 0;\nlet undoStack = [], redoStack = [];\nlet occ = new Map();\n\nconst fp = (t,rot) => rot%2 ? {w:t.d,d:t.w} : {w:t.w,d:t.d};\nfunction rebuildOcc(){\n  occ = new Map();\n  for(const b of bricks) cellsOf(b).forEach(k=>occ.set(k,b.id));\n}\nfunction cellsOf(b){\n  const t = TYPE[b.type], f = fp(t,b.rot), out=[];\n  for(let x=b.x;x<b.x+f.w;x++)for(let z=b.z;z<b.z+f.d;z++)for(let l=b.l;l<b.l+t.h;l++) out.push(x+','+z+','+l);\n  return out;\n}\nfunction fits(b){ return cellsOf(b).every(k=>!occ.has(k)); }\n\n// ---------- three ----------\nconst canvas = document.getElementById('view');\nconst renderer = new THREE.WebGLRenderer({canvas, antialias:true, preserveDrawingBuffer:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio,2));\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\nconst scene = new THREE.Scene();\nconst camera = new THREE.PerspectiveCamera(40,1,0.1,500);\nconst controls = new THREE.OrbitControls(camera, canvas);\ncontrols.enableDamping = true; controls.dampingFactor = 0.12;\ncontrols.maxPolarAngle = Math.PI*0.49; controls.minDistance = 6; controls.maxDistance = 90;\ncontrols.mouseButtons = {LEFT:THREE.MOUSE.ROTATE, MIDDLE:THREE.MOUSE.DOLLY, RIGHT:THREE.MOUSE.PAN};\nfunction homeView(){ camera.position.set(N/2-16, 22, N/2+24); controls.target.set(N/2,1.5,N/2); controls.update(); }\nhomeView();\n\nscene.add(new THREE.HemisphereLight(0xffffff, 0x8090a8, 0.75));\nconst sun = new THREE.DirectionalLight(0xffffff, 0.75);\nsun.position.set(N/2-14, 34, N/2+10); sun.target.position.set(N/2,0,N/2);\nsun.castShadow = true; sun.shadow.mapSize.set(2048,2048);\nObject.assign(sun.shadow.camera,{left:-24,right:24,top:24,bottom:-24,near:1,far:90});\nsun.shadow.bias = -0.0006;\nscene.add(sun, sun.target);\n\n// base\nconst baseMat = new THREE.MeshStandardMaterial({color:0xb9c0cb, roughness:.6});\nconst base = new THREE.Mesh(new THREE.BoxGeometry(N,0.3,N), baseMat);\nbase.position.set(N/2,-0.15,N/2); base.receiveShadow = true; scene.add(base);\nconst studGeo = new THREE.CylinderGeometry(0.29,0.29,0.18,20);\nconst baseStuds = new THREE.InstancedMesh(studGeo, baseMat, N*N);\n{ const m = new THREE.Matrix4(); let i=0;\n  for(let x=0;x<N;x++)for(let z=0;z<N;z++){ m.makeTranslation(x+.5,0.09,z+.5); baseStuds.setMatrixAt(i++,m); } }\nbaseStuds.receiveShadow = true; baseStuds.raycast = ()=>{}; scene.add(baseStuds);\nconst pickPlane = new THREE.Mesh(new THREE.PlaneGeometry(N,N), new THREE.MeshBasicMaterial({visible:false}));\npickPlane.rotation.x = -Math.PI/2; pickPlane.position.set(N/2,0,N/2); scene.add(pickPlane);\n\nfunction themeColors(){\n  const cs = getComputedStyle(document.documentElement);\n  scene.background = new THREE.Color(cs.getPropertyValue('--scene').trim()||'#cdd4df');\n  const dark = scene.background.getHSL({}).l < .3;\n  baseMat.color.set(dark ? 0x3a4458 : 0xb9c0cb);\n}\nthemeColors();\nmatchMedia('(prefers-color-scheme: dark)').addEventListener('change',themeColors);\nnew MutationObserver(themeColors).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});\n\n// geometrías por tipo\nconst geoCache = {};\nfunction bodyGeo(t){\n  if(geoCache[t.id]) return geoCache[t.id];\n  const H = t.h*PH, w=t.w-0.04, d=t.d-0.04;\n  let g;\n  if(t.kind==='slope'){\n    const s = new THREE.Shape(), z0=-d/2, z1=d/2, lip=PH*0.6;\n    s.moveTo(z0,0); s.lineTo(z1,0); s.lineTo(z1,lip); s.lineTo(z0+1-0.02,H-0.01); s.lineTo(z0,H-0.01); s.lineTo(z0,0);\n    g = new THREE.ExtrudeGeometry(s,{depth:w,bevelEnabled:false});\n    g.rotateY(-Math.PI/2); g.translate(w/2,-H/2,0);\n  } else if(t.kind==='round'){\n    g = new THREE.CylinderGeometry(0.48,0.48,H-0.01,28);\n  } else {\n    g = new THREE.BoxGeometry(w,H-0.01,d);\n  }\n  return geoCache[t.id]=g;\n}\nconst edgeMat = new THREE.LineBasicMaterial({color:0x000000, transparent:true, opacity:.28});\nconst glassMat = new THREE.MeshStandardMaterial({color:0xbfe3ff, transparent:true, opacity:.45, roughness:.05});\nconst matCache = {};\nfunction mat(colorId){\n  return matCache[colorId] ||= new THREE.MeshStandardMaterial({color:COLOR[colorId].hex, roughness:.32, metalness:0});\n}\nfunction studPositions(t){\n  const H=t.h*PH, out=[];\n  if(t.kind==='tile') return out;\n  if(t.kind==='slope'){ for(let x=0;x<t.w;x++) out.push([x-t.w/2+.5, H/2+.09, -t.d/2+.5]); return out; }\n  for(let x=0;x<t.w;x++)for(let z=0;z<t.d;z++) out.push([x-t.w/2+.5,H/2+.09,z-t.d/2+.5]);\n  return out;\n}\nfunction buildMesh(type,colorId,material){\n  const t = TYPE[type], g = new THREE.Group(), m = material || mat(colorId);\n  let body;\n  if(t.kind==='window'){\n    // marco con vidrio\n    const H=t.h*PH, w=t.w-.04, d=t.d-.04, fr=0.16;\n    const parts=[[w,fr,d,0,H/2-fr/2],[w,fr,d,0,-H/2+fr/2],[fr,H,d,-w/2+fr/2,0],[fr,H,d,w/2-fr/2,0]];\n    body = new THREE.Group();\n    parts.forEach(([a,b,c,x,y])=>{const p=new THREE.Mesh(new THREE.BoxGeometry(a,b,c),m);p.position.set(x,y,0);p.castShadow=p.receiveShadow=true;body.add(p);});\n    const gl = new THREE.Mesh(new THREE.BoxGeometry(w-2*fr,H-2*fr,0.06), material||glassMat); body.add(gl);\n    body.userData.isBody=true; g.add(body);\n  } else {\n    body = new THREE.Mesh(bodyGeo(t), m);\n    body.castShadow = body.receiveShadow = true; g.add(body);\n    const e = new THREE.LineSegments(new THREE.EdgesGeometry(bodyGeo(t),30), edgeMat); e.raycast=()=>{}; g.add(e);\n  }\n  for(const [x,y,z] of studPositions(t)){\n    const s = new THREE.Mesh(studGeo, m); s.position.set(x,y,z); s.castShadow=true; s.raycast=()=>{}; g.add(s);\n  }\n  return g;\n}\nfunction placeGroup(g,b){\n  const t=TYPE[b.type], f=fp(t,b.rot);\n  g.position.set(b.x+f.w/2, b.l*PH + t.h*PH/2, b.z+f.d/2);\n  g.rotation.y = -b.rot*Math.PI/2;\n}\n\nconst brickRoot = new THREE.Group(); scene.add(brickRoot);\nconst meshById = new Map();\nfunction syncScene(){\n  for(const g of meshById.values()) brickRoot.remove(g);\n  meshById.clear();\n  for(const b of bricks){\n    const g = buildMesh(b.type,b.color); g.userData.id=b.id; placeGroup(g,b);\n    brickRoot.add(g); meshById.set(b.id,g);\n  }\n  rebuildOcc(); renderBOM(); updateStatus(); save();\n}\n\n// fantasma\nconst ghostMat = new THREE.MeshStandardMaterial({transparent:true, opacity:.55, depthWrite:false});\nlet ghost=null, ghostState=null;\nfunction rebuildGhost(){\n  if(ghost) scene.remove(ghost);\n  ghostMat.color.set(COLOR[curColor].hex);\n  ghost = buildMesh(curType,curColor,ghostMat);\n  ghost.traverse(o=>{o.raycast=()=>{}; o.castShadow=false;});\n  ghost.visible=false; scene.add(ghost);\n}\nconst hoverBox = new THREE.BoxHelper(undefined, 0xf2b705); hoverBox.visible=false; scene.add(hoverBox);\n\n// ---------- selección con el puntero ----------\nconst ray = new THREE.Raycaster(), ndc = new THREE.Vector2();\nfunction hitAt(cx,cy){\n  const r = canvas.getBoundingClientRect();\n  ndc.set(((cx-r.left)/r.width)*2-1, -((cy-r.top)/r.height)*2+1);\n  ray.setFromCamera(ndc,camera);\n  const hits = ray.intersectObjects([pickPlane, brickRoot], true);\n  if(!hits.length) return null;\n  const h = hits[0];\n  let o=h.object; while(o && o.userData.id===undefined && o!==scene) o=o.parent;\n  const id = o && o.userData.id;\n  const n = h.face ? h.face.normal.clone().transformDirection(h.object.matrixWorld) : new THREE.Vector3(0,1,0);\n  return {point:h.point, normal:n, brick: id ? bricks.find(b=>b.id===id) : null};\n}\nfunction placementFor(hit){\n  const t=TYPE[curType], f=fp(t,curRot);\n  let q = hit.point.clone(), l=0;\n  if(hit.brick){\n    const bt=TYPE[hit.brick.type];\n    if(hit.normal.y>0.9){ l = hit.brick.l+bt.h; }\n    else if(hit.normal.y<-0.9){ l = Math.max(0,hit.brick.l - t.h); }\n    else { q.addScaledVector(hit.normal,0.5); l = hit.brick.l; }\n  }\n  let x = Math.round(q.x - f.w/2), z = Math.round(q.z - f.d/2);\n  x = Math.max(0,Math.min(N-f.w,x)); z = Math.max(0,Math.min(N-f.d,z));\n  const b = {type:curType,color:curColor,x,z,l,rot:curRot};\n  for(let i=0;i<80 && !fits(b);i++) b.l++;\n  return fits(b) ? b : null;\n}\n\nfunction updateHover(cx,cy,shift){\n  const hit = hitAt(cx,cy);\n  const mode = shift ? 'delete' : tool;\n  ghost.visible=false; hoverBox.visible=false; ghostState=null;\n  if(!hit) return;\n  if(mode==='place'){\n    const b = placementFor(hit);\n    if(b){ ghostState=b; placeGroup(ghost,b); ghost.visible=true; }\n  } else if(hit.brick){\n    hoverBox.setFromObject(meshById.get(hit.brick.id));\n    hoverBox.material.color.set(mode==='delete'?0xff4d3d:0xf2b705);\n    hoverBox.visible=true;\n  }\n}\n\nfunction snapshot(){ undoStack.push(JSON.stringify(bricks)); if(undoStack.length>200) undoStack.shift(); redoStack=[]; updUndo(); }\nfunction act(cx,cy,shift){\n  const hit = hitAt(cx,cy); if(!hit) return;\n  const mode = shift ? 'delete' : tool;\n  if(mode==='place'){\n    const b = placementFor(hit); if(!b) return toast('No hay lugar para esa pieza ahí');\n    snapshot(); b.id = nextId++; bricks.push(b);\n    const g = buildMesh(b.type,b.color); g.userData.id=b.id; placeGroup(g,b); brickRoot.add(g); meshById.set(b.id,g);\n    cellsOf(b).forEach(k=>occ.set(k,b.id)); renderBOM(); updateStatus(); save();\n  } else if(hit.brick){\n    const b = hit.brick;\n    if(mode==='delete'){ snapshot(); bricks = bricks.filter(x=>x!==b); syncScene(); hoverBox.visible=false; }\n    else if(mode==='paint'){ if(b.color===curColor) return; snapshot(); b.color=curColor; syncScene(); }\n    else if(mode==='pick'){ curType=b.type; curColor=b.color; curRot=b.rot; setTool('place'); refreshPalette(); rebuildGhost(); toast('Pieza copiada: '+label(b.type)+' '+COLOR[b.color].name.toLowerCase()); }\n  }\n  updateHover(cx,cy,shift);\n}\n\nlet down=null;\ncanvas.addEventListener('pointerdown',e=>{ down={x:e.clientX,y:e.clientY,b:e.button}; });\ncanvas.addEventListener('pointerup',e=>{\n  if(down && down.b===0 && Math.hypot(e.clientX-down.x,e.clientY-down.y)<6) act(e.clientX,e.clientY,e.shiftKey);\n  down=null;\n});\ncanvas.addEventListener('pointermove',e=>{ lastPt={x:e.clientX,y:e.clientY}; if(e.pointerType==='mouse' && !(e.buttons&1)) updateHover(e.clientX,e.clientY,e.shiftKey); });\ncanvas.addEventListener('pointerleave',()=>{ ghost.visible=false; hoverBox.visible=false; });\ncanvas.addEventListener('contextmenu',e=>e.preventDefault());\n\n// ---------- UI ----------\nconst label = id => { const t=TYPE[id]; return (catLabel[t.cat]? catLabel[t.cat]+' ':'')+t.name; };\nfunction setTool(t){\n  tool=t; document.querySelectorAll('[data-tool]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.tool===t)));\n  canvas.style.cursor = t==='place'?'crosshair':t==='delete'?'not-allowed':'pointer';\n  updateStatus();\n}\ndocument.querySelectorAll('[data-tool]').forEach(b=>b.onclick=()=>setTool(b.dataset.tool));\nlet lastPt=null;\nfunction rotate(){ curRot=(curRot+1)%4; ghost.visible=false; if(lastPt) updateHover(lastPt.x,lastPt.y,false); updateStatus(); }\ndocument.getElementById('rot').onclick=rotate;\ndocument.getElementById('home').onclick=homeView;\n\nfunction updUndo(){ document.getElementById('undo').disabled=!undoStack.length; document.getElementById('redo').disabled=!redoStack.length; }\nfunction undo(){ if(!undoStack.length) return; redoStack.push(JSON.stringify(bricks)); bricks=JSON.parse(undoStack.pop()); syncScene(); updUndo(); }\nfunction redo(){ if(!redoStack.length) return; undoStack.push(JSON.stringify(bricks)); bricks=JSON.parse(redoStack.pop()); syncScene(); updUndo(); }\ndocument.getElementById('undo').onclick=undo; document.getElementById('redo').onclick=redo;\n\nconst sw = document.getElementById('swatches');\nCOLORS.forEach(c=>{\n  const b=document.createElement('button'); b.className='sw'; b.style.background=c.hex; b.title=c.name; b.setAttribute('aria-label',c.name);\n  b.dataset.c=c.id; b.onclick=()=>{curColor=c.id; refreshPalette(); rebuildGhost(); renderThumbs(); if(tool==='delete'||tool==='pick') setTool('place');};\n  sw.appendChild(b);\n});\nconst piecesEl = document.getElementById('pieces');\nlet lastCat=null, grid=null;\nTYPES.forEach(t=>{\n  if(t.cat!==lastCat){ lastCat=t.cat; const h=document.createElement('div'); h.className='cat'; h.textContent=t.cat; piecesEl.appendChild(h);\n    grid=document.createElement('div'); grid.className='pieces'; piecesEl.appendChild(grid); }\n  const b=document.createElement('button'); b.className='pc'; b.dataset.t=t.id; b.title=label(t.id);\n  b.innerHTML='<img alt=\"\"><span>'+t.name+'</span>';\n  b.onclick=()=>{curType=t.id; curRot=0; refreshPalette(); rebuildGhost(); setTool('place');};\n  grid.appendChild(b);\n});\nfunction refreshPalette(){\n  document.querySelectorAll('.sw').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.c===curColor)));\n  document.querySelectorAll('.pc').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.t===curType)));\n  updateStatus();\n}\n\n// miniaturas\nconst thumbR = new THREE.WebGLRenderer({antialias:true, alpha:true, preserveDrawingBuffer:true});\nthumbR.setSize(128,128);\nconst tScene = new THREE.Scene();\ntScene.add(new THREE.HemisphereLight(0xffffff,0x707a90,.9));\nconst tl = new THREE.DirectionalLight(0xffffff,.7); tl.position.set(-3,6,4); tScene.add(tl);\nconst tCam = new THREE.PerspectiveCamera(30,1,.1,100);\nfunction renderThumbs(){\n  document.querySelectorAll('.pc').forEach(btn=>{\n    const t=TYPE[btn.dataset.t], g=buildMesh(t.id,curColor);\n    tScene.add(g);\n    const size = Math.max(t.w,t.d,t.h*PH*1.5);\n    const dist = size*2.1+1.2;\n    tCam.position.set(-dist*.62, dist*.62, dist*.72); tCam.lookAt(0,0,0);\n    thumbR.render(tScene,tCam);\n    btn.querySelector('img').src = thumbR.domElement.toDataURL();\n    tScene.remove(g);\n  });\n}\n\nfunction renderBOM(){\n  const el=document.getElementById('bom'); const map=new Map();\n  bricks.forEach(b=>{const k=b.type+'|'+b.color; map.set(k,(map.get(k)||0)+1);});\n  if(!map.size){ el.innerHTML='<p class=\"empty\">Todavía no hay piezas. Elegí una pieza y un color a la izquierda y hacé clic sobre la base.</p>'; return; }\n  const rows=[...map].sort((a,b)=>TYPES.indexOf(TYPE[a[0].split('|')[0]])-TYPES.indexOf(TYPE[b[0].split('|')[0]]) || b[1]-a[1]);\n  el.innerHTML = rows.map(([k,n])=>{const [t,c]=k.split('|');\n    return `<div class=\"row\"><span class=\"dot\" style=\"background:${COLOR[c].hex}\"></span><span>${label(t)} · ${COLOR[c].name.toLowerCase()}</span><span class=\"n\">${n}</span></div>`;}).join('')\n    + `<div class=\"total\"><span>Total</span><span>${bricks.length} piezas</span></div>`;\n}\nfunction updateStatus(){\n  const f=fp(TYPE[curType],curRot);\n  const names={place:'Colocar',paint:'Pintar',pick:'Copiar',delete:'Quitar'};\n  const top = bricks.reduce((m,b)=>Math.max(m,b.l+TYPE[b.type].h),0);\n  document.getElementById('status').innerHTML = `<b>${names[tool]}</b> · ${label(curType)} ${COLOR[curColor].name.toLowerCase()} · ${f.w}×${f.d} tetones · giro ${curRot*90}° · altura ${top} placas`;\n}\n\n// guardar / cargar\nfunction save(){ try{ localStorage.setItem(STORE, JSON.stringify({v:1,bricks})); }catch(e){} }\nfunction load(list){\n  bricks = list.filter(b=>TYPE[b.type]&&COLOR[b.color]).map(b=>({id:0,type:b.type,color:b.color,x:b.x|0,z:b.z|0,l:b.l|0,rot:(b.rot|0)%4}));\n  bricks.forEach(b=>b.id=nextId++); syncScene();\n}\n\nlet toastT; function toast(m){ const t=document.getElementById('toast'); t.textContent=m; t.hidden=false; clearTimeout(toastT); toastT=setTimeout(()=>t.hidden=true,2200); }\n\nconst dlg=document.getElementById('dlg'), area=document.getElementById('dlgArea'), okBtn=document.getElementById('dlgOk'), fileLbl=document.getElementById('fileLbl');\nlet dlgMode='exp';\ndocument.getElementById('expBtn').onclick=()=>{\n  dlgMode='exp'; document.getElementById('dlgTitle').textContent='Exportar construcción';\n  document.getElementById('dlgText').textContent='Copiá este texto y guardalo en un archivo .json o pegalo en un mensaje. Con Importar lo podés volver a abrir en cualquier navegador.';\n  area.value=JSON.stringify({app:'taller-de-ladrillos',v:1,bricks:bricks.map(({id,...r})=>r)}); area.readOnly=true;\n  okBtn.textContent='Copiar'; fileLbl.hidden=true; dlg.showModal(); area.select();\n};\ndocument.getElementById('impBtn').onclick=()=>{\n  dlgMode='imp'; document.getElementById('dlgTitle').textContent='Importar construcción';\n  document.getElementById('dlgText').textContent='Pegá el texto exportado o abrí un archivo .json. La construcción actual se reemplaza (podés deshacer).';\n  area.value=''; area.readOnly=false; okBtn.textContent='Importar'; fileLbl.hidden=false; dlg.showModal(); area.focus();\n};\ndocument.getElementById('fileIn').onchange=e=>{ const f=e.target.files[0]; if(!f) return; const r=new FileReader(); r.onload=()=>area.value=r.result; r.readAsText(f); };\ndocument.getElementById('dlgCancel').onclick=()=>dlg.close();\nokBtn.onclick=async()=>{\n  if(dlgMode==='exp'){\n    try{ await navigator.clipboard.writeText(area.value); toast('Copiado al portapapeles'); dlg.close(); }\n    catch(e){ area.select(); toast('Seleccionado: usá Ctrl+C para copiar'); }\n  } else {\n    try{ const d=JSON.parse(area.value); const list=Array.isArray(d)?d:d.bricks; if(!Array.isArray(list)) throw 0;\n      snapshot(); load(list); dlg.close(); toast(`Importadas ${bricks.length} piezas`); hideBanner(); }\n    catch(e){ toast('Ese texto no es una construcción válida. Revisá que esté completo.'); }\n  }\n};\n\n// vaciar con confirmación en dos pasos\nconst clearBtn=document.getElementById('clearBtn'); let armed=null;\nclearBtn.onclick=()=>{\n  if(!bricks.length) return;\n  if(!armed){ clearBtn.textContent='¿Seguro? Tocá de nuevo'; armed=setTimeout(()=>{armed=null;clearBtn.textContent='Vaciar';},3000); return; }\n  clearTimeout(armed); armed=null; clearBtn.textContent='Vaciar';\n  snapshot(); bricks=[]; syncScene(); toast('Base vacía. Ctrl+Z para recuperar');\n};\nconst banner=document.getElementById('banner'); const hideBanner=()=>banner.hidden=true;\ndocument.getElementById('bannerX').onclick=hideBanner;\ndocument.getElementById('newBtn').onclick=()=>{ snapshot(); bricks=[]; syncScene(); hideBanner(); };\ndocument.getElementById('sampleBtn').onclick=()=>{ snapshot(); load(sample()); };\ndocument.getElementById('partsBtn').onclick=()=>document.getElementById('parts').classList.toggle('open');\n\naddEventListener('keydown',e=>{\n  if(dlg.open || /INPUT|TEXTAREA/.test(e.target.tagName)) return;\n  const k=e.key.toLowerCase();\n  if((e.ctrlKey||e.metaKey)&&k==='z'){ e.preventDefault(); e.shiftKey?redo():undo(); return; }\n  if((e.ctrlKey||e.metaKey)&&k==='y'){ e.preventDefault(); redo(); return; }\n  if(k==='r') rotate();\n  else if(k==='c') homeView();\n  else if(k==='1') setTool('place'); else if(k==='2') setTool('paint'); else if(k==='3') setTool('pick'); else if(k==='4') setTool('delete');\n});\n\n// modelo de ejemplo: casita\nfunction sample(){\n  const L=[], add=(type,color,x,z,l,rot=0)=>L.push({type,color,x,z,l,rot});\n  const X=12, Z=12;\n  for(const l of [0,3,6]){\n    const c = l===3?'blanco':'rojo';\n    add('b1x2',c,X,Z,l); add('b1x2',c,X+4,Z,l);\n    if(l===6) add('b1x2',c,X+2,Z,l);\n    add('b1x2',c,X,Z+3,l); add('b1x2',c,X+4,Z+3,l);\n    if(l!==3) add('b1x2',c,X+2,Z+3,l);\n    add('b1x2',c,X,Z+1,l,1); add('b1x2',c,X+5,Z+1,l,1);\n  }\n  add('w1x2','amarillo',X+2,Z+3,3);\n  add('p2x4','blanco',X,Z,9); add('p2x4','blanco',X,Z+2,9); add('p2x2','blanco',X+4,Z,9); add('p2x2','blanco',X+4,Z+2,9);\n  for(const x of [X,X+2,X+4]){ add('s2x2','azul',x,Z,10,2); add('s2x2','azul',x,Z+2,10,0); }\n  add('p4x8','gris',X-1,Z-4,0);\n  // árbol\n  add('c1x1','marron',X+9,Z+1,0); add('c1x1','marron',X+9,Z+1,3);\n  add('b2x2','verde',X+8,Z+1,6,0); add('b1x1','verde',X+9,Z+1,9);\n  // cerco\n  add('b1x4','amarillo',X-3,Z+7,0); add('b1x4','amarillo',X+1,Z+7,0); add('b1x4','amarillo',X+5,Z+7,0); add('b1x4','amarillo',X+9,Z+7,0);\n  return L;\n}\n\n// ---------- arranque ----------\nfunction resize(){\n  const r=canvas.parentElement.getBoundingClientRect();\n  renderer.setSize(r.width,r.height,false); camera.aspect=r.width/Math.max(1,r.height); camera.updateProjectionMatrix();\n}\nnew ResizeObserver(resize).observe(canvas.parentElement); resize();\n\nlet saved=null; try{ saved=JSON.parse(localStorage.getItem(STORE)); }catch(e){}\nif(saved && Array.isArray(saved.bricks) && saved.bricks.length){ load(saved.bricks); banner.hidden=true; }\nelse load(sample());\nrefreshPalette(); rebuildGhost(); renderThumbs(); setTool('place'); updUndo();\n\n(function loop(){ controls.update(); renderer.render(scene,camera); requestAnimationFrame(loop); })();\n})();\n</script>","extensions":null}